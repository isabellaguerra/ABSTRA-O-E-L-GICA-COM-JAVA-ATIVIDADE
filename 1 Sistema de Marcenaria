import java.util.Scanner;

class Retangulo {
    private double largura;
    private double altura;


    public Retangulo(double largura, double altura) {
        this.largura = largura;
        this.altura = altura;
    }

    public double calcularArea() {
        return largura * altura;
    }

    public double calcularPerimetro() {
        return 2 * (largura + altura);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner leitor = new Scanner(System.in);

        System.out.println(" Marcenaria: Cálculo de Tampos ");
        
        System.out.print("Informe a largura do tampo (m): ");
        double l = leitor.nextDouble();
        
        System.out.print("Informe a altura do tampo (m): ");
        double a = leitor.nextDouble();

        Retangulo tampo = new Retangulo(l, a);

      
        System.out.println("\n--- Relatório de Fabricação ---");
        System.out.println("Madeira necessária (Área): " + tampo.calcularArea() + " m²");
        System.out.println("Fita de borda (Perímetro): " + tampo.calcularPerimetro() + " m");

        leitor.close();
    }
}
