mport java.util.Scanner;


class Esfera {
    private double raio;

    public Esfera(double raio) {
        this.raio = raio;
    }


    public double calcularVolume() {
        return (4.0 / 3.0) * Math.PI * Math.pow(raio, 3);
    }

    
    public double calcularAreaSuperficie() {
        return 4 * Math.PI * Math.pow(raio, 2);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner leitor = new Scanner(System.in);

     
        System.out.print("Digite o raio da bola (em cm): ");
        double raioDigitado = leitor.nextDouble();

      
        Esfera bola = new Esfera(raioDigitado);

     
        System.out.println("\n--- Propriedades Físicas ---");
        System.out.println("Volume: " + bola.calcularVolume() + " cm³");
        System.out.println("Área da Superfície: " + bola.calcularAreaSuperficie() + " cm²");

        leitor.close();
    }
}
