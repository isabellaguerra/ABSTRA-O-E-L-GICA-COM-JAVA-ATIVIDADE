import java.util.Scanner;

class Pessoa {
    private String nome;
    private double peso;
    private double altura;

    public Pessoa(String nome, double peso, double altura) {
        this.nome = nome;
        this.peso = peso;
        this.altura = altura;
    }

    public double calcularIMC() {
        return peso / (altura * altura);
    }

    public String classificar() {
        double imc = calcularIMC();
        if (imc < 18.5) return "Abaixo do peso";
        if (imc < 25) return "Peso normal";
        if (imc < 30) return "Sobrepeso";
        return "Obesidade";
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner leitor = new Scanner(System.in);

        System.out.print("Nome do paciente: ");
        String nome = leitor.nextLine();
        System.out.print("Peso (kg): ");
        double p = leitor.nextDouble();
        System.out.print("Altura (ex: 1.75): ");
        double a = leitor.nextDouble();

        Pessoa paciente = new Pessoa(nome, p, a);

        System.out.println("\n--- Relatório de Saúde ---");
        System.out.println("Paciente: " + nome);
        System.out.println("IMC: " + paciente.calcularIMC());
        System.out.println("Resultado: " + paciente.classificar());

        leitor.close();
    }
}
